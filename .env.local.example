# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase
# (Supabase > Project Settings > API > aba "Legacy anon, service_role API keys")

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave de servidor (NUNCA exponha no navegador / NUNCA suba pro Git público)
# Necessária só para criar usuários, resetar senha e excluir usuários
# (operações administrativas do Supabase Auth que a anon key não alcança).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
