# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publishable

# Necessária só para criar usuários e redefinir senhas (Configurações > Usuários).
# Pegue em: Supabase > Project Settings > API Keys > Secret keys.
# NUNCA coloque essa chave em um arquivo enviado ao GitHub, nem a compartilhe
# fora do seu próprio .env.local (ela dá acesso total ao banco).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-aqui
